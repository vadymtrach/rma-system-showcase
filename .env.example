POSTGRES_DB=admin_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret_password
SPRING_PORT=8080

# Initial admin account, created on first start (only while no active admin exists).
# These are demo values: change them before running anywhere other than your own machine.
BOOTSTRAP_ADMIN_EMAIL=admin123@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=admin123

# Comma-separated browser origins allowed for the API and WebSocket (your public URL).
ALLOWED_ORIGINS=https://localhost
